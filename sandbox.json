  "denyRead": [
    "~/.ssh",
    "~/.gnupg",
    "~/.aws",
    "~/.config/gcloud",
    "~/.config/gh",
    "~/.config/.cf",
    "~/.config/cf",
    "~/.config/fnox",
    "~/.config/Proton",
    "~/.config/Proton Pass",
    "~/.pi/agent/auth.json",
    "~/.docker",
    "~/.kube"
  ],
  "scrubEnv": []
}
