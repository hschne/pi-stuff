{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--config",
        "/home/hschne/.pi/agent/playwright-mcp.json"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--executablePath",
        "/run/current-system/sw/bin/chromium",
        "--no-usageStatistics",
        "--no-performanceCrux"
      ]
    }
  }
}
