{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--config",
        "/home/hschne/.pi/agent/playwright-mcp.json"
      ]
    },
    "playwright-live": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--config",
        "/home/hschne/.pi/agent/playwright-live-mcp.json"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--executablePath",
        "/run/current-system/sw/bin/chromium",
        "--no-usageStatistics",
        "--no-performanceCrux"
      ]
    },
    "buffer": {
      "url": "https://mcp.buffer.com/mcp",
      "auth": "bearer",
      "bearerToken": "!fnox get BUFFER_API_KEY"
    }
  }
}
